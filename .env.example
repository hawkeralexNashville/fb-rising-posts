# ---- Retro Pong environment variables ----

# PostgreSQL connection string.
# On Railway this is provided automatically by the Postgres plugin as DATABASE_URL.
# For local dev, point it at your own Postgres instance:
DATABASE_URL=postgresql://user:password@localhost:5432/retropong

# Secret used to sign JWT auth tokens. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Port the HTTP + WebSocket server listens on. Railway sets this automatically.
PORT=3000

# Public base URL of the deployed site, used for canonical/OG tags and sitemap.xml.
# Update this to your Railway URL or custom domain once deployed.
BASE_URL=https://retro-pong.up.railway.app
